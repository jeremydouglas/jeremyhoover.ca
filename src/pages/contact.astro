---
import BaseLayout from '../layouts/BaseLayout.astro'
import Container from '../components/Container.astro'
---

<BaseLayout title="Contact | Jeremy Hoover">
  <Container>
    <h1>get in touch</h1>
    <p>
      Interested in working together? Have a question or just want to say hello? I'd love to hear
      from you. Choose a channel that works for you:
    </p>
    <div class="contactOptions">
      <div>
        <span class="label">Email</span>
        <a href="mailto:hello@jeremyhoover.ca">hello@jeremyhoover.ca</a>
      </div>
      <div>
        <span class="label">X</span>
        <a href="https://x.com/jeremydouglas">@jeremydouglas</a>
      </div>
      <div><span class="label">Discord</span> <code>.jeremydouglas</code></div>
    </div>
  </Container>
</BaseLayout>

<style>
  .contactOptions {
    display: flex;
    gap: var(--space-sm);
    font-size: var(--font-size-2xl);
    flex-direction: column;
    margin-top: var(--space-xl);
  }

  .label {
    display: inline-block;
    width: 4em;
  }
</style>
