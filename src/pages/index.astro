---
import '../styles/global.css'
import Body from '../components/Body.astro'
import Navbar from '../components/Navbar.astro'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/png" href="/icons/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="shortcut icon" href="/icons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Jeremy" />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <title>Jeremy Hoover | UX Developer, Frontend Developer</title>
  </head>
  <body>
    <Navbar />
    <main>
      <Body />
    </main>
  </body>
</html>

<style>
  html {
    background-color: var(--pallet-grey-200);
  }

  body {
    background-image: linear-gradient(to bottom, var(--pallet-grey-200), var(--pallet-grey-100));
    background-attachment: fixed;
  }
</style>
