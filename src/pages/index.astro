---
import BaseLayout from '../layouts/BaseLayout.astro'
import Container from '../components/Container.astro'
---

<BaseLayout title="Jeremy Hoover | UX Developer, Frontend Developer">
  <section class="background">
    <Container>
      <p class="text-display">
        Hello, good <span class="time-greeting" id="time-greeting">day</span>
        <span class="wave">👋</span>
      </p>
      <p class="text-display">
        I’m Jeremy, a web developer with a background in design and a passion for UX.
      </p>
      <p class="text-display">
        I’m into growing vegetables, playing guitar and building thoughtful user journeys that seem
        to just make sense. Luckily, one of these three has been an employable skill, and led to a
        career. The path I have traveled since the early 2000s has led me to approach web
        development with a wide perspective, bridging from design to focus on development. Many of
        my colleagues have seen me as the “glue” that keeps the team together.
      </p>
      <p class="text-display">
        I appreciate that you have taken the time to stop by and visit my website. Other things you
        might want to do around here are check out <a href="/work">my work</a>, learn more <a
          href="/about">about me</a
        > or <a href="/contact">get in touch</a>.
      </p>
    </Container>
  </section>
</BaseLayout>

<script is:inline>
  function updateGreeting() {
    const greetingEl = document.getElementById('time-greeting')

    if (greetingEl) {
      const hour = new Date().getHours()

      let timeOfDay = 'day'
      if (hour < 12) timeOfDay = 'morning'
      if (hour >= 12 && hour < 18) timeOfDay = 'afternoon'
      if (hour >= 18 || hour < 5) timeOfDay = 'evening'

      greetingEl.textContent = timeOfDay
    }
  }

  updateGreeting()
  document.addEventListener('astro:page-load', updateGreeting)
</script>
