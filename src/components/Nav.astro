---
const normalize = (path: string): string => {
  if (path === '/') return '/'
  return path.endsWith('/') ? path : `${path}/`
}

const currentPath = normalize(Astro.url.pathname)
---

<nav class="nav" aria-label="Primary">
  <a href="/work/" class:list={[{ active: currentPath === '/work/' }]}>work</a>
  <a href="/about/" class:list={[{ active: currentPath === '/about/' }]}>about</a>
  <a href="/contact/" class:list={[{ active: currentPath === '/contact/' }]}>contact</a>
</nav>

<style>
  .nav {
    background-color: color-mix(in srgb, var(--bg), transparent 85%);
    display: flex;
    gap: var(--space-xl);
    justify-content: center;
    width: 100%;
    margin-top: 8px;
    padding: 8px 0;
    border-radius: 8px;
    border: 2px solid color-mix(in srgb, var(--muted), transparent 75%);

    @media (min-width: 816px) {
      background-color: unset;
      border: none;
      justify-content: flex-end;
      margin-left: auto;
      margin-top: 0;
      padding: 0;
      width: auto;
    }
  }

  .nav a {
    font-size: var(--font-size-lg);
    color: var(--muted);
    transition: color 0.3s ease;
    text-decoration: none;
  }

  .nav a:hover,
  .nav a.active {
    color: color-mix(in srgb, var(--muted), var(--bg) 15%);
  }
</style>
