---
const normalize = (path: string): string => {
  if (path === '/') return '/'
  return path.endsWith('/') ? path : `${path}/`
}

const currentPath = normalize(Astro.url.pathname)
---

<nav class="nav" aria-label="Primary">
  <a href="/work/" class:list={[{ active: currentPath === '/work/' }]}>work</a>
  <a href="/about/" class:list={[{ active: currentPath === '/about/' }]}>about</a>
  <a href="/contact/" class:list={[{ active: currentPath === '/contact/' }]}>contact</a>
</nav>

<style>
  .nav {
    display: flex;
    justify-content: center;
    gap: var(--space-md);

    @container (min-width: 700px) {
      gap: var(--space-xl);
      margin-left: auto;
      justify-content: flex-end;
    }
  }

  .nav a {
    font-size: var(--font-size-lg);
    color: var(--muted);
    transition: color 0.3s ease;
    text-decoration: none;
  }

  .nav a:hover,
  .nav a.active {
    color: color-mix(in rgba, var(--muted), var(--bg) 15%);
  }
</style>
