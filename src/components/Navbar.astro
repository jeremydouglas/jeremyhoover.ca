---
import Profile from "./Profile.astro";
import Nav from "./Nav.astro";
---

<header class="header" role="banner">
  <div class="inner">
    <Profile />
    <Nav />
  </div>
</header>

<style>
  .header {
    padding: 1.25rem var(--container-padding);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }
</style>
