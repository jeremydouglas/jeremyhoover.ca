---
import Profile from './Profile.astro'
import Nav from './Nav.astro'
---

<header class="header" role="banner">
  <div class="inner">
    <Profile />
    <Nav />
  </div>
</header>

<style>
  .header {
    padding: 20px var(--container-padding);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: var(--max-width);
    margin: 0 auto;
  }
</style>
