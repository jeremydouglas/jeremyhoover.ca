---
import Profile from './Profile.astro'
import Nav from './Nav.astro'
---

<header class="header" role="banner" transition:persist transition:animate="none">
  <div class="inner">
    <Profile />
    <Nav />
  </div>
</header>

<style>
  .header {
    padding: var(--space-lg) var(--container-padding);
    container-name: 'header';
    container-type: inline-size;
    filter: blur(5px);
    animation: unblur 1s ease-out forwards;
  }

  @keyframes unblur {
    from {
      filter: blur(10px);
      opacity: 0;
    }
    to {
      filter: blur(0);
      opacity: 1;
    }
  }

  .inner {
    align-content: center;
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: 0 auto;
    max-width: var(--space-11xl);

    @container (min-width: 720px) {
      gap: var(--space-xl);
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
    }
  }

  :global(.skip-header-animation) .header {
    animation: none;
    filter: none;
    opacity: 1;
  }
</style>
