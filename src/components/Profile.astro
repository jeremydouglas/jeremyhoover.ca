---

---

<a class="container" href="/">
  <div class="avatar">
    <img class="avatar-image avatar-image-1" src="/images/headshot.png" alt="Jeremy Hoover" />
    <img class="avatar-image avatar-image-2" src="/images/headshot.png" alt="Jeremy Hoover" />
  </div>
  <div class="meta">
    <div class="name">jeremy douglas hoover</div>
    <div class="role">ux developer</div>
    <div class="location">hamilton, ontario, canada</div>
  </div>
</a>

<style>
  .container {
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
  }

  .avatar {
    aspect-ratio: 1 / 1;
    width: 80px;
    border-radius: 999px;
    object-fit: cover;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 0 0 3px var(--bg),
      0 0 0 4px color-mix(in srgb, var(--muted) 25%, transparent);
    transition: box-shadow 0.4s ease-out;
    background: var(--background);
  }

  .container:hover .avatar {
    box-shadow:
      0 0 0 3px var(--bg),
      0 0 0 4px color-mix(in srgb, var(--muted) 80%, transparent);
  }

  .avatar-image {
    -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    filter: grayscale(100%);
    transition: filter 0.2s ease-out;
  }

  .container:hover .avatar-image {
    filter: none;
  }

  .container:hover .avatar-image-1 {
    opacity: 0.75;
  }

  .avatar-image-1 {
    opacity: 0.5;
    z-index: 2;
    transition: opacity 0.2s ease-out;
  }

  .avatar-image-2 {
    mix-blend-mode: multiply;
    opacity: 0.9;
  }

  .meta {
    line-height: 1;
    display: grid;
    gap: 6px;
    grid-template-columns: 1fr;
  }

  .name {
    text-transform: lowercase;
    font-weight: 500;
    font-size: var(--font-size-sm);
  }

  .role {
    color: var(--muted);
    font-size: var(--font-size-xs);
  }

  .location {
    color: var(--muted);
    font-size: var(--font-size-xs);
  }
</style>
