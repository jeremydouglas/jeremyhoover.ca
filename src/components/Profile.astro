<div class="container">
  <a href="/"><img class="avatar" src="/images/headshot.png" alt="Jeremy Hoover" /></a>
  <div class="meta">
    <div class="name">jeremy hoover</div>
    <div class="role">ux developer</div>
    <div class="location">hamilton, ontario, canada</div>
  </div>
</div>

<style>
  .container {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .avatar {
    aspect-ratio: 1 / 1;
    width: 80px;
    border-radius: 999px;
    object-fit: cover;
  }

  .meta {
    line-height: 1;
    display: grid;
    gap: 6px;
    grid-template-columns: 1fr;
  }

  .name {
    text-transform: lowercase;
    font-weight: 500;
    font-size: var(--font-size-sm);
  }

  .role {
    color: var(--muted);
    font-size: var(--font-size-xs);
  }

  .location {
    color: var(--muted);
    font-size: var(--font-size-xs);
  }
</style>
