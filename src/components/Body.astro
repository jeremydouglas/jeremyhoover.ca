---
import Container from './Container.astro'
---

<section class="section">
  <Container>
    <div class="content">
      <p class="greeting">
        Hello, good <span class="time-greeting" id="time-greeting">morning</span>
        <span class="wave">👋</span>
      </p>
      <p class="lead">
        I’m Jeremy, a web developer with a background in design and a passion for UX.
      </p>
      <div class="body">
        <p>
          The path I have taken over the last twenty years has led me to approach web development
          with a wide perspective. Many of my colleagues have seen me as the “glue” that keeps the
          team together.
        </p>
        <p>
          I thrive at methodically hashing out ideas to build interactions that just make sense to
          users. I am well seasoned with over twenty years in the industry.
        </p>
        <p>
          I want to personally thank you for stopping by and visiting my website. Other things you
          might want to do around here are <a href="/work">check out my work</a>, learn more <a
            href="/about">about me</a
          > or <a href="/contact">get in touch</a>.
        </p>
      </div>
    </div>
  </Container>
</section>

<script is:inline>
  const greetingEl = document.getElementById('time-greeting')

  if (greetingEl) {
    const hour = new Date().getHours()

    let timeOfDay = 'morning'
    if (hour >= 12 && hour < 18) timeOfDay = 'afternoon'
    if (hour >= 18 || hour < 5) timeOfDay = 'evening'

    greetingEl.textContent = timeOfDay
  }
</script>

<style>
  .section {
    background-color: var(--pallet-grey-100);
    background-image: url('/images/hero-texture.svg');
    background-repeat: no-repeat;
    background-position: center top;
    padding: var(--space-4xl) 0;
    container-type: inline-size;
  }

  .content {
    position: relative;
    padding: 0 var(--container-padding);
    font-size: clamp(var(--font-size-lg), 2vw + 1rem, var(--font-size-xl));
  }

  .content p {
    margin: 0 0 0.75em;
  }

  .greeting {
    font-size: inherit;
    font-weight: normal;
  }

  .lead {
    font-size: inherit;
    font-weight: normal;
  }

  .body {
    max-width: var(--max-width);
    color: var(--muted);
    font-size: inherit;
  }

  .body a {
    color: var(--accent);
    text-decoration: underline;
  }

  .wave {
    display: inline-block;
  }
</style>
